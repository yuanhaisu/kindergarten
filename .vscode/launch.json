    "version": "0.2.0",
    "configurations": [
        {
            "name": "server",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "env": {
                "CONFIG_PATH": "${workspaceFolder}/server/configs/app.ini"
            },
            "program": "${workspaceFolder}/server/cmd/api/main.go"
        },
        {
            "type": "node-terminal",
            "name": "admin",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/admin"
        },
        {
            "type": "node-terminal",
            "name": "teacher",
            "request": "launch",
            "command": "npm run dev:mp-weixin",
            "cwd": "${workspaceFolder}/teacher"
        },
        {
            "type": "node-terminal",
            "name": "parent",
            "request": "launch",
            "command": "npm run dev:mp-weixin",
            "cwd": "${workspaceFolder}/parent"
        }
    ]
}