# 仓库根 .gitignore
# 说明：各子项目（admin/ teacher/ parent/ server/ shared-design-tokens/）另有自己的
# .gitignore 处理就近规则；此文件负责根级路径与跨端通用产物。

# === 依赖 ===
node_modules/

# === uni-app / 小程序构建产物 ===
# miniprogram_npm 是 uni-app 编译时把依赖搬进小程序包的产物，可由 npm 重建
miniprogram_npm/
dist/
.hbuilderx/
unpackage/

# === Nuxt（admin） ===
.nuxt/
.output/

# === Go 构建产物 ===
server/bin/

# === 环境变量 ===
# 各端 .env.example 是模板，必须保留；.env.local 等本地覆盖不入库
.env.local
.env.*.local

# === IDE ===
.idea/
*.swp
*.swo

# === 操作系统 ===
.DS_Store
Thumbs.db
desktop.ini

# === 日志 ===
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 注意：shared-design-tokens/build/ 是构建产物，但按 CLAUDE.md 规定
# 「产物必须提交」——tokens.json 变更后需重建并一并提交，故此处不忽略。

# 人脸实测样本（含儿童照片，敏感，禁止提交）
assets/face-img/

# Ruflo local secrets and runtime data
.env
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/

# === 本地验证脚本（含临时 JWT 签名密钥，禁止提交）===
# _verify/ 下的脚本会自行签发测试用 JWT，密钥明文写在源码里。
# 它们是一次性的验证工具，不是项目产物；一旦入库就等于又泄漏一次凭据。
# 这个仓库的历史已经因明文凭据欠了一笔账，不要再欠第二笔。
_verify/

# === Ruflo 本地运行时状态 ===
# 向量库、记忆库、agent 工作区都是本机工具链状态，跨机器不可复用
# 整目录忽略：上面按子目录逐条列会漏掉 daemon-state / metrics / memory 等状态文件
.claude-flow/
.swarm/
.agents/
agentdb.rvf
agentdb.rvf.lock
ruvector.db
.claude/settings.json
.claude/settings.local.json
.claude/proven-config.json
.claude/.proven-config-version
.claude/*.bak
.claude/*.bak-*

# Slice-delivery runtime state: checkpoints, logs, DevTools lock (local only)
.claude/runs/
.claude/locks/

# Python 字节码
__pycache__/

# `ruflo init` 之类的工具会不断往 .claude/skills/ 塞通用技能，黑名单永远追不上。
# 改成白名单：默认忽略，项目自有的技能逐个放行。
# ⚠️ 新增项目技能时，必须在这里补一条 `!`，否则它会被静默忽略、永远进不了仓库。
.claude/skills/*
!.claude/skills/admin-run/
!.claude/skills/algorithmic-art/
!.claude/skills/brand-guidelines/
!.claude/skills/canvas-design/
!.claude/skills/claude-api/
!.claude/skills/doc-coauthoring/
!.claude/skills/docx/
!.claude/skills/dual-ide-verification/
!.claude/skills/frontend-design/
!.claude/skills/golang-wechat-backend/
!.claude/skills/growth-records/
!.claude/skills/impeccable/
!.claude/skills/internal-comms/
!.claude/skills/mcp-builder/
!.claude/skills/openspec-apply-change/
!.claude/skills/openspec-archive-change/
!.claude/skills/openspec-explore/
!.claude/skills/openspec-propose/
!.claude/skills/openspec-sync-specs/
!.claude/skills/openspec-update-change/
!.claude/skills/pdf/
!.claude/skills/pptx/
!.claude/skills/skill-creator/
!.claude/skills/slice-delivery/
!.claude/skills/slice-delivery/**
!.claude/skills/slack-gif-creator/
!.claude/skills/system-enums/
!.claude/skills/template/
!.claude/skills/theme-factory/
!.claude/skills/webapp-testing/
!.claude/skills/web-artifacts-builder/
!.claude/skills/xlsx/
