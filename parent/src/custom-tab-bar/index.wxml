<view class="ctb">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="ctb__item {{selected === index ? 'is-active' : ''}}"
    data-index="{{index}}"
    bindtap="onTabTap"
  >
    <image class="ctb__icon" src="{{selected === index ? item.iconActive : item.icon}}" mode="aspectFit" />
    <text class="ctb__label">{{item.text}}</text>
  </view>
</view>
