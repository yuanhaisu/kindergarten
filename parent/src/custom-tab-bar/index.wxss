/*
 * 原生 custom-tab-bar 被原样复制到 dist，不经过 SCSS 编译，无法引用 $token 变量。
 * 图标字体由 app.wxss 里的 @font-face 全局注册（App.vue 引 remixicon.css），
 * 组件 options.styleIsolation = "apply-shared" 即可用。
 * 不要在本文件里引入 remixicon.css：WXSS 不支持导入 .css，编译期静默失败会让所有 tab 页白屏。
 *
 * DNA 迁移验证：悬浮白色胶囊底栏。数值对应 docs/design-dna/2026-11-11-kinderly：
 *   #FFFFFF 卡片面 / #173220 深松绿 / #728173 次级文字 / sage 激活底。
 * 高度约 96rpx，加上下留白仍小于原 126rpx，页面 bottom-space 不需要改。
 */
.ctb {
  position: fixed;
  right: 24rpx;
  bottom: calc(8rpx + env(safe-area-inset-bottom));
  left: 24rpx;
  z-index: 999;
  display: flex;
  justify-content: space-around;
  align-items: center;
  box-sizing: border-box;
  padding: 12rpx 8rpx;
  border: 1rpx solid rgba(23, 50, 32, 0.1);
  border-radius: 999rpx;
  background: #FFFFFF;
  box-shadow: 0 20rpx 48rpx -24rpx rgba(23, 50, 32, 0.35);
}

.ctb__item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 2rpx 0;
  border-radius: 999rpx;
}

.ctb__item.is-active {
  background: rgba(141, 163, 134, 0.22);
}

.ctb__icon {
  font-family: remixicon;
  font-size: 44rpx;
  line-height: 1;
  color: #728173;
}

.ctb__label {
  font-size: 24rpx;
  line-height: 1.2;
  color: #728173;
}

.ctb__item.is-active .ctb__icon {
  color: #173220;
}

.ctb__item.is-active .ctb__label {
  color: #173220;
  font-weight: 500;
}
