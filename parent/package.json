{
  "name": "kindergarten-parent-mini-program",
  "version": "0.1.0",
  "private": true,
  "description": "幼儿园家长端微信小程序",
  "scripts": {
    "predev:mp-weixin": "node ../scripts/sync-ui.js && cd ../shared-design-tokens && npm run build",
    "prebuild:mp-weixin": "node ../scripts/sync-ui.js && cd ../shared-design-tokens && npm run build",
    "prebuild:mp-weixin:test": "node ../scripts/sync-ui.js && cd ../shared-design-tokens && npm run build",
    "prebuild:mp-weixin:prod": "node ../scripts/sync-ui.js && cd ../shared-design-tokens && npm run build",
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-weixin:test": "uni build -p mp-weixin --mode test",
    "build:mp-weixin:prod": "uni build -p mp-weixin --mode production"
  },
  "dependencies": {
    "@dcloudio/uni-app": "^3.0.0-alpha-5000820260420001",
    "@dcloudio/uni-h5": "^3.0.0-alpha-5000820260420001",
    "@dcloudio/uni-mp-weixin": "^3.0.0-alpha-5000820260420001",
    "kindergarten-design-tokens": "file:../shared-design-tokens",
    "qrcode-generator": "^2.0.4",
    "remixicon": "^4.9.1",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "@dcloudio/vite-plugin-uni": "^3.0.0-alpha-5000820260420001",
    "sass": "^1.99.0",
    "vite": "^5.2.8"
  }
}
