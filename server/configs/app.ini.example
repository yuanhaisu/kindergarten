; 配置模板 —— 复制为 app.ini 后填入真实值
; 真正的 app.ini 已被 .gitignore 忽略，不会入库
;
; 所有敏感项都支持环境变量覆盖（优先级高于本文件）：
;   MYSQL_DSN  REDIS_ADDR  REDIS_PASSWORD  JWT_SECRET
;   WECHAT_TEACHER_APP_ID  WECHAT_TEACHER_SECRET
;   WECHAT_PARENT_APP_ID   WECHAT_PARENT_SECRET
;   OSS_ENDPOINT  OSS_ACCESS_KEY_ID  OSS_ACCESS_KEY_SECRET  OSS_BUCKET
;   GIN_MODE  HTTP_ADDR  JWT_ACCESS_TTL_MIN

[app]
http_addr = :8080
gin_mode  = debug

[log]
level  = debug
format = text

[mysql]
; 格式: user:password@tcp(host:port)/dbname?charset=utf8mb4&parseTime=True&loc=Local
dsn = root:CHANGE_ME@tcp(127.0.0.1:3306)/kindergarten?charset=utf8mb4&parseTime=True&loc=Local

[redis]
addr     = 127.0.0.1:6379
password = CHANGE_ME
db       = 0

[jwt]
secret           = CHANGE_ME
access_ttl_min   = 15
refresh_ttl_day  = 7

[wechat]
; 两端小程序 AppID 必须分开（openid 是「用户×小程序」二元的，共用会串号）。
; 家长端保留原 AppID（getPhoneNumber 仅非个人主体可用）；老师端用另一套。
teacher_app_id  = CHANGE_ME
teacher_secret  = CHANGE_ME
parent_app_id   = CHANGE_ME
parent_secret   = CHANGE_ME
; 以下为旧的单对键，仅作回滚兼容（两端都空时回填到两端）。新配置不要写这里。
;app_id  =
;secret  =

[casbin]
enable      = true
model_path  = configs/rbac_model.conf
policy_path = configs/rbac_policy.csv

[oss]
endpoint          =
access_key_id     =
access_key_secret =
bucket_name       =

[face]
; 人脸识别（腾讯云 IAI）。密钥只存在于后端，绝不下发客户端。
; provider: mock（无凭证开发环境）| tencent
provider     = mock
enabled      = false
secret_id    =
secret_key   =
region       = ap-beijing
qps          = 10
daily_budget = 10000
; 建议阈值（0-100）：高置信预勾 / 低置信提示。真实数据校准后调整。
suggest_high = 80
suggest_low  = 70
group_photo_min_faces = 6
