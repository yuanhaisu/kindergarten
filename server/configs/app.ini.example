; 配置模板 —— 复制为 app.ini 后填入真实值
; 真正的 app.ini 已被 .gitignore 忽略，不会入库
;
; 所有敏感项都支持环境变量覆盖（优先级高于本文件）：
;   MYSQL_DSN  REDIS_ADDR  REDIS_PASSWORD  JWT_SECRET
;   WECHAT_APP_ID  WECHAT_SECRET
;   OSS_ENDPOINT  OSS_ACCESS_KEY_ID  OSS_ACCESS_KEY_SECRET  OSS_BUCKET
;   GIN_MODE  HTTP_ADDR  JWT_ACCESS_TTL_MIN

[app]
http_addr = :8080
gin_mode  = debug

[log]
level  = debug
format = text

[mysql]
; 格式: user:password@tcp(host:port)/dbname?charset=utf8mb4&parseTime=True&loc=Local
dsn = root:CHANGE_ME@tcp(127.0.0.1:3306)/kindergarten?charset=utf8mb4&parseTime=True&loc=Local

[redis]
addr     = 127.0.0.1:6379
password = CHANGE_ME
db       = 0

[jwt]
secret           = CHANGE_ME
access_ttl_min   = 15
refresh_ttl_day  = 7

[wechat]
app_id  = CHANGE_ME
secret  = CHANGE_ME

[casbin]
enable      = true
model_path  = configs/rbac_model.conf
policy_path = configs/rbac_policy.csv

[oss]
endpoint          =
access_key_id     =
access_key_secret =
bucket_name       =
