# Admin · 成就（依赖 ../_login.http）

@baseUrl = http://localhost:8080
@token = {{adminPasswordLogin.response.body.$.data.token}}

### 列表
GET {{baseUrl}}/api/v1/admin/achievements?page=1&page_size=20
Authorization: Bearer {{token}}

### 新建
POST {{baseUrl}}/api/v1/admin/achievements
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "手工小达人",
  "description": "参与20次手工制作活动",
  "icon_url": "https://cdn.example.com/badges/craft.png",
  "category": "growth",
  "condition": "craft_activities_20",
  "target_value": 20
}

### 编辑（id 换成本地）
PUT {{baseUrl}}/api/v1/admin/achievements/1
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "手工小达人",
  "description": "参与15次手工制作活动（降低门槛）",
  "target_value": 15
}

### 删除
DELETE {{baseUrl}}/api/v1/admin/achievements/1
Authorization: Bearer {{token}}
