# 渲染：envsubst '$DOMAIN' < kindergarten.conf.tmpl > /etc/nginx/conf.d/kindergarten.conf
# 只替换 ${DOMAIN}，保留 Nginx 自身的 $host / $remote_addr 等变量。
# 放置位置：/etc/nginx/conf.d/kindergarten.conf

limit_req_zone $binary_remote_addr zone=api_limit:10m rate=10r/s;

# HTTP → HTTPS
server {
    listen 80;
    server_name api.${DOMAIN} admin.${DOMAIN} test-api.${DOMAIN} test-admin.${DOMAIN} ${DOMAIN} www.${DOMAIN} test-www.${DOMAIN};
    return 301 https://$host$request_uri;
}

# 生产 API
server {
    listen 443 ssl;
    http2 on;
    server_name api.${DOMAIN};

    ssl_certificate     /etc/nginx/ssl/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 25m;
    gzip on;
    gzip_types application/json text/plain text/css application/javascript image/svg+xml;

    location /api/v1/ {
        limit_req zone=api_limit burst=20 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 120s;
    }
    location = /health { proxy_pass http://127.0.0.1:8080; proxy_set_header Host $host; }
    location = /ready  { proxy_pass http://127.0.0.1:8080; proxy_set_header Host $host; }
}

