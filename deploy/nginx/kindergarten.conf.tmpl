# 生产管理端（静态 SPA + 同源 /api/v1）
server {
    listen 443 ssl;
    http2 on;
    server_name admin.${DOMAIN};
    # 生产站点不设访问门禁（#53 只作用于 staging；生产是否加门禁另行决策）。

    ssl_certificate     /etc/nginx/ssl/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    root  /opt/kindergarten/prod/admin/current;
    index index.html;
    client_max_body_size 25m;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /_nuxt/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
    location /api/v1/ {
        limit_req zone=api_limit burst=20 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 120s;
    }
    location = /health { proxy_pass http://127.0.0.1:8080; proxy_set_header Host $host; }
    location = /ready  { proxy_pass http://127.0.0.1:8080; proxy_set_header Host $host; }
}

# 预发管理端
server {
    listen 443 ssl;
    http2 on;
    server_name test-admin.${DOMAIN};

    ssl_certificate     /etc/nginx/ssl/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    root  /opt/kindergarten/staging/admin/current;
    index index.html;
    client_max_body_size 25m;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # staging 访问门禁：凭据只存在服务器（/etc/nginx/htpasswd/kindergarten-staging）
    # 只盖住静态入口与资源；API、健康检查、ACME 在下面显式豁免。
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
        try_files $uri =404;
    }
    location /_nuxt/ {
        auth_basic "Kindergarten staging";
        auth_basic_user_file /etc/nginx/htpasswd/kindergarten-staging;
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
    location / {
        auth_basic "Kindergarten staging";
        auth_basic_user_file /etc/nginx/htpasswd/kindergarten-staging;
        try_files $uri $uri/ /index.html;
    }
    location /api/v1/ {
        auth_basic off;
        limit_req zone=api_limit burst=20 nodelay;
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_read_timeout 120s;
    }
    location = /health {
        auth_basic off;
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
    }
    location = /ready  {
        auth_basic off;
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $host;
    }
}

# 官网：apex 统一跳到 www
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/nginx/ssl/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    return 301 https://www.${DOMAIN}$request_uri;
}

# 生产官网（纯静态）
server {
    listen 443 ssl;
    http2 on;
    server_name www.${DOMAIN};
    # 生产站点不设访问门禁（#53 只作用于 staging；生产是否加门禁另行决策）。

    ssl_certificate     /etc/nginx/ssl/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    root  /opt/kindergarten/prod/website/current;
    index index.html;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location /_nuxt/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
    location ~* ^/(screens|brand)/ {
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }
    location / {
        # 目录型页面（/privacy、/terms）直接读 index.html，不 301 到带斜杠；
        # 带斜杠的重复地址反向 301 到无斜杠，保持 canonical / sitemap 一致。
        rewrite ^/(.+)/$ /$1 permanent;
        try_files $uri $uri/index.html $uri/ =404;
    }
    error_page 404 /404.html;
}

# 预发官网
server {
    listen 443 ssl;
    http2 on;
    server_name test-www.${DOMAIN};

    ssl_certificate     /etc/nginx/ssl/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/${DOMAIN}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;

    # 预发与生产共用同一份静态产物：用响应头挡住收录，避免 test-www 与 www 重复。
    add_header X-Robots-Tag "noindex, nofollow" always;

    root  /opt/kindergarten/staging/website/current;
    index index.html;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # staging 访问门禁：只盖住页面入口；政策页与静态资源保持匿名可用。
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/acme;
        default_type text/plain;
        try_files $uri =404;
    }
    # 本站无后端；显式 404 并保持匿名，避免将来接入后端时被门禁拦截。
    location ^~ /api/v1/ { auth_basic off; return 404; }
    location = /health  { auth_basic off; return 404; }
    location = /ready   { auth_basic off; return 404; }
    # 家长端 web-view 会匿名打开政策页（test-www 与生产共用同一份静态产物，不构成额外暴露）。
    location = /privacy {
        auth_basic off;
        try_files $uri/index.html =404;
    }
    location = /terms {
        auth_basic off;
        try_files $uri/index.html =404;
    }
    # 匿名访问的 404（含政策页缺失时的 error_page）不能反被门禁挡成 401
    location = /404.html {
        auth_basic off;
        try_files $uri =404;
    }
    location ~* ^/(screens|brand)/ {
        auth_basic off;
        expires 7d;
        add_header Cache-Control "public";
        try_files $uri =404;
    }
    # 政策页引用的 _nuxt / 图片 / 图标必须匿名可读，否则 web-view 里版面与插图裂开。
    location ~* \.(?:css|js|mjs|json|webp|png|jpe?g|gif|svg|ico|woff2?|ttf|xml|txt|webmanifest)$ {
        auth_basic off;
        try_files $uri =404;
    }
    location ^~ /_nuxt/ {
        auth_basic off;
        expires 30d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
    location / {
        auth_basic "Kindergarten staging";
        auth_basic_user_file /etc/nginx/htpasswd/kindergarten-staging;
        # 目录型页面（/privacy、/terms）直接读 index.html，不 301 到带斜杠；
        # 带斜杠的重复地址反向 301 到无斜杠，保持 canonical / sitemap 一致。
        rewrite ^/(.+)/$ /$1 permanent;
        try_files $uri $uri/index.html $uri/ =404;
    }
    error_page 404 /404.html;
}
