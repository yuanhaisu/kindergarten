# 复制为 deploy/.env（已被根 .gitignore 的 .env 规则忽略），填入真实值。
ACR_REGISTRY=registry.cn-hangzhou.aliyuncs.com
ACR_NAMESPACE=your-namespace
IMAGE_TAG=v2026.11.04-1

# 迁移账号 DSN（DDL）。只注入 migrate 容器，不要给 api 容器。
# staging 指向 mysql:3306；prod 指向 RDS。
# 必须用单引号包住：deploy.sh / rollback.sh 会 source 本文件，裸值里的 & 会被当成后台执行。
MIGRATE_MYSQL_DSN='kg_migrate:CHANGE_ME@tcp(mysql:3306)/kindergarten?charset=utf8mb4&parseTime=True&loc=Asia%2FShanghai'

# 生产发布前快照（snapshot-rds.sh）使用
RDS_INSTANCE_ID=rm-CHANGE_ME

# 仅 staging 使用
STAGING_MYSQL_ROOT_PASSWORD=CHANGE_ME
STAGING_MYSQL_USER=kg_app
STAGING_MYSQL_PASSWORD=CHANGE_ME
STAGING_REDIS_PASSWORD=CHANGE_ME
